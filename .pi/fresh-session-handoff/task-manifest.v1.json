{
  "manifestVersion": "1",
  "taskId": "pi-fresh-session-handoff",
  "title": "Fresh-session handoff extension",
  "summary": "Checkpointed fresh-session handoff with stale checks, launch dedupe, ack-gated editing, and threshold hooks.",
  "semanticFacts": {
    "ackBeforeEdit": "required",
    "rawTranscriptStorage": "forbidden",
